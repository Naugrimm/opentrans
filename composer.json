{
    "name": "naugrim/opentrans",
    "description": "A library to create openTRANS compatible XML documents.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Erik Anders",
            "email": "erik.anders@securepoint.de"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-dom": "*",
        "ext-libxml": "*",
        "jms/serializer": "^3.30.0",
        "naugrim/bmecat": "^6.0",
        "webmozart/assert": "^1.11"
    },
    "autoload": {
        "psr-4": {
            "Naugrim\\OpenTrans\\Tests\\": "tests/",
            "Naugrim\\OpenTrans\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12",
        "symplify/easy-coding-standard": "^12.0",
        "rector/rector": "^2.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-webmozart-assert": "^2.0",
        "tomasvotruba/type-coverage": "^2.0"
    },
    "scripts": {
        "test": "@php -dzend_extension=xdebug.so -dxdebug.mode=coverage vendor/bin/phpunit ",
        "ecs": "@php vendor/bin/ecs ",
        "ecs-fix": "@php vendor/bin/ecs --fix ",
        "rector": "@php vendor/bin/rector process ",
        "stan": "@php vendor/bin/phpstan analyze ",
        "check-all": [
          "@ecs-fix",
          "@rector",
          "@stan",
          "@test"
        ],
        "post-autoload-dump": [
            "git config gitflow.path.hooks .githooks && git config core.hooksPath .githooks"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Utils\\Rector\\": [
                "utils/rector/src",
                "vendor/naugrim/bmecat/utils/rector/src"
            ],
            "Utils\\Rector\\Tests\\": "utils/rector/tests"
        },
        "files": [
          "vendor/rector/rector/preload.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
